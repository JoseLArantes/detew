{
  "name": "@detew/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "vite",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/check-generated-contracts.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts vite.config.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "vite build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
